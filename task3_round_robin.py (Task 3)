PART 1 — Zone Job-Scheduler & Deadlock-Safety Engine (60 marks)

from collections import deque
from jobs import JOBS

def run_round_robin(quantum):
    jobs = [dict(j) for j in JOBS]
    n = len(jobs)
    rem_time = [j["burst_time"] for j in jobs]
    arrival_time = [j["arrival_time"] for j in jobs]
    
    current_time = 0
    completed = 0
    ready_queue = deque()
    in_queue = [False] * n
    finish_time = [0] * n
    
    context_switches = 0
    last_running_job = None
    dispatch_slices = 0
    
    def add_new_arrivals(time_limit):
        for i in range(n):
            if arrival_time[i] <= time_limit and not in_queue[i] and rem_time[i] > 0:
                ready_queue.append(i)
                in_queue[i] = True

    add_new_arrivals(0)
    
    while completed < n:
        if not ready_queue:
            current_time += 1
            add_new_arrivals(current_time)
            continue
            
        idx = ready_queue.popleft()
        dispatch_slices += 1
        
        if last_running_job != jobs[idx]["job_id"]:
            if last_running_job is not None:
                context_switches += 1
            last_running_job = jobs[idx]["job_id"]
            
        exec_time = min(quantum, rem_time[idx])
        
        for _ in range(exec_time):
            current_time += 1
            rem_time[idx] -= 1
            # Rule: Add newly arrived jobs BEFORE re-adding the expired job
            add_new_arrivals(current_time)
            
        if rem_time[idx] == 0:
            completed += 1
            finish_time[idx] = current_time
        else:
            ready_queue.append(idx)

    tot_wt = 0
    tot_tat = 0
    for i in range(n):
        tat = finish_time[i] - arrival_time[i]
        wt = tat - jobs[i]["burst_time"]
        tot_wt += wt
        tot_tat += tat

    avg_wt = tot_wt / n
    avg_tat = tot_tat / n

    print(f"\n================ Round Robin (Quantum = {quantum}) ================")
    print(f"Average Waiting Time   : {avg_wt:.2f}")
    print(f"Average Turnaround Time: {avg_tat:.2f}")
    print(f"Dispatch Slices        : {dispatch_slices}")
    print(f"Context Switches       : {context_switches}")
    return avg_wt, avg_tat, context_switches, dispatch_slices

if __name__ == "__main__":
    run_round_robin(3)
    run_round_robin(6)
    
    print("\n--- Theoretical Analysis Statement ---")
    print("A real operating system would pay significantly higher CPU overhead at quantum 3 than at quantum 6 "
          "because quantum 3 incurs 16 context switches across 17 dispatch slices, whereas quantum 6 incurs only "
          "10 context switches across 11 dispatch slices for this workload.")
